#!/bin/bash
# rmv - rm that shows the list first, and deletes exactly the list it showed.
#
# The point of a preview is that what you reviewed is what gets deleted.
# Running `ls <pattern>` and then `rm <pattern>` expands the pattern twice, so
# anything created in between is deleted without ever appearing on screen. Here
# the shell expands once into argv; that array is frozen, displayed, and then
# handed to rm unchanged.
#
#   rmv -p *.log
#   rmv -rfp build dist
#   rmv -p -- -weird-name.txt
#
# Without -p it is rm. With -p every delete is confirmed;
# RMV_QUIET_THRESHOLD=3 lets deletes of up to three plain files through.
#
# Install (tcsh):  alias rm '~/bin/rmv -p'
# Aliases do not apply inside scripts, so scripts keep getting the real rm.

set -u

LS=/bin/ls
RM=/bin/rm

# Every delete is shown and confirmed. Set RMV_QUIET_THRESHOLD to a count to let
# small flat deletes through untouched instead -- 3 skips the prompt for
# `rm a b c` while still catching globs and anything recursive.
QUIET_THRESHOLD=${RMV_QUIET_THRESHOLD:-0}

prog=${0##*/}

usage() {
    cat <<EOF
Usage: $prog [OPTION]... FILE...

With -p, show the targets and ask before deleting them, and delete exactly the
list that was shown. Listing is done by $LS, removal by $RM.

Without -p this is $RM, so the same file can be called from scripts. Put the
flag in the interactive alias instead of typing it.

Options:
  -p, --preview         show the targets and confirm before deleting
  -r, -R, --recursive   remove directories and their contents
  -f, --force           ignore nonexistent files, never report an error
  -h, --help            show this help
  --                    treat every later argument as a file name
                        (for file names that begin with -)

  Any other option is passed through to $RM unchanged.

Environment:
  RMV_QUIET_THRESHOLD   with -p, let deletes of this many plain files through
                        without a prompt. Default 0, meaning always confirm.
                        With 3, \`$prog -p a b c\` goes straight through while
                        globs, directories and anything recursive still confirm.

  -p only asks when stdin is a terminal. Without one, or when CLAUDECODE,
  AI_AGENT, FARAD_AGENT or CODEX_SANDBOX is set (an agent is running the
  command), it deletes without asking, like $RM.

Examples:
  $prog -p *.log
  $prog -rfp build dist
  $prog -p -- -dash-file.txt

Install (tcsh):
  mkdir -p ~/bin && cp $prog ~/bin/ && chmod +x ~/bin/$prog
  alias rm '~/bin/$prog -p'     # in ~/.cshrc

  Aliases do not apply inside scripts, so existing scripts keep getting the
  real $RM.
EOF
}

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

# Help is ours, not rm's, so it has to be answered before anything is handed
# over. Only arguments before -- are considered: after it everything is a name.
for a in "$@"; do
    case $a in
        --) break ;;
        -h|--help) usage; exit 0 ;;
    esac
done

# Without -p this is rm. The preview costs a flag so that the same file can sit
# on PATH and be called from scripts, while the interactive alias carries the
# flag and always previews:  alias rm '~/bin/rmv -p'
#
# The short form is matched with a second character that is not a dash, so that
# long options containing a p -- --preserve-root above all -- are left alone.
preview=0
for a in "$@"; do
    case $a in
        --) break ;;
        --preview) preview=1; break ;;
        -[!-]*p*|-p) preview=1; break ;;
    esac
done

if [ "$preview" -eq 0 ]; then
    exec "$RM" "$@"
fi

opts=()
targets=()
ambiguous=()
recursive=0
force=0
end_of_opts=0

while [ $# -gt 0 ]; do
    arg=$1
    shift

    if [ "$end_of_opts" -eq 1 ]; then
        targets+=("$arg")
        continue
    fi

    # A glob can hand us a file whose name starts with a dash, and argv cannot
    # say whether `-r' means "recursive" or "the file called -r". Guessing
    # either way is destructive: read as an option it silently turns on
    # recursion and drops the file from the listing, read as a file it ignores
    # a flag that was meant. Stop instead and make the caller disambiguate.
    case $arg in
        --)
            # The delimiter itself is never ambiguous, even where a file called
            # -- exists: that file is named by the argument after this one.
            ;;
        -?*)
            if [ -e "$arg" ] || [ -L "$arg" ]; then
                ambiguous+=("$arg")
            fi
            ;;
    esac

    case $arg in
        --)
            end_of_opts=1
            ;;
        --preview)
            # Consumed here; rm knows nothing about it.
            ;;
        --recursive)
            recursive=1
            opts+=("$arg")
            ;;
        --force)
            force=1
            opts+=("$arg")
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            # Unrecognised long option: hand it to rm untouched.
            opts+=("$arg")
            ;;
        -?*)
            # A short-option cluster such as -rf. Inspect every letter so that
            # recursion is detected however it was spelled.
            case $arg in
                *[rR]*) recursive=1 ;;
            esac
            case $arg in
                *f*) force=1 ;;
            esac
            # Take our own flag back out of the cluster before rm sees it. Only
            # short clusters reach here; long options matched --* above.
            arg=${arg//p/}
            if [ "$arg" != "-" ]; then
                opts+=("$arg")
            fi
            ;;
        *)
            targets+=("$arg")
            ;;
    esac
done

# ${arr[@]} on an empty array trips `set -u` under bash 3.2, so expand guarded.
opt_args=(${opts[@]+"${opts[@]}"})
tgt_args=(${targets[@]+"${targets[@]}"})
amb_args=(${ambiguous[@]+"${ambiguous[@]}"})
n=${#tgt_args[@]}

if [ ${#amb_args[@]} -gt 0 ]; then
    for a in "${amb_args[@]}"; do
        echo "$prog: '$a' is both an option and a file that exists here" >&2
    done
    echo "$prog: refusing to guess. To delete them:  $prog -- <file>..." >&2
    echo "$prog: to pass them as options, delete the files another way first." >&2
    exit 1
fi

if [ "$n" -eq 0 ]; then
    if [ "$force" -eq 1 ]; then
        exit 0
    fi
    echo "$prog: missing operand (try '$prog --help')" >&2
    exit 1
fi

has_dir=0
for t in "${tgt_args[@]}"; do
    if [ -d "$t" ] && [ ! -L "$t" ]; then
        has_dir=1
        break
    fi
done

if [ "$n" -le "$QUIET_THRESHOLD" ] && [ "$recursive" -eq 0 ] && [ "$has_dir" -eq 0 ]; then
    exec "$RM" ${opt_args[@]+"${opt_args[@]}"} -- "${tgt_args[@]}"
fi

# Confirm only when a person is at the keyboard. Agents source the same rc file
# and so get the alias, but nobody reads their prompt: stdin that never closes
# hangs the command, and an agent on a pty would stall on /dev/tty. Without a
# terminal on stdin, or under a known agent marker, the delete goes through.
if [ ! -t 0 ] || [ -n "${CLAUDECODE-}${AI_AGENT-}${FARAD_AGENT-}${CODEX_SANDBOX-}" ]; then
    exec "$RM" ${opt_args[@]+"${opt_args[@]}"} -- "${tgt_args[@]}"
fi

# Force colour rather than letting ls autodetect, so the listing survives a
# pipe into less -R. GNU spells it --color=always; BSD spells it -G.
color=()
if "$LS" --color=always -d . >/dev/null 2>&1; then
    color=(--color=always)
elif "$LS" -G -d . >/dev/null 2>&1; then
    color=(-G)
fi

# -d so a directory is listed as itself rather than expanded into its contents,
# -F so directories and symlinks are distinguishable at a glance. The arguments
# are the frozen target list, never the original pattern.
"$LS" -dF ${color[@]+"${color[@]}"} -- "${tgt_args[@]}"

printf '\n%s: delete %d items? [y/N] > ' "$prog" "$n"

# stdin is a terminal here. Read the answer from /dev/tty, falling back to stdin;
# EOF leaves it empty, which cancels. Redirections apply left to right, so
# 2>/dev/null has to come first to swallow a failing open.
answer=
read -r answer 2>/dev/null < /dev/tty || read -r answer || answer=

case $answer in
    y|Y|yes|YES) ;;
    *)
        echo "$prog: cancelled" >&2
        exit 1
        ;;
esac

exec "$RM" ${opt_args[@]+"${opt_args[@]}"} -- "${tgt_args[@]}"
